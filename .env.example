# Kopieer naar .env en vul in.

# Zet op 1 zodra de Studio via HTTPS (Cloudflare Tunnel) bereikbaar is.
SECURE_COOKIES=0

# Optioneel: commando dat na elke publicatie draait. $SITE_DIR is de map met de gebouwde site.
# Voorbeeld voor Cloudflare Pages (vereist CLOUDFLARE_API_TOKEN en CLOUDFLARE_ACCOUNT_ID):
# PUBLISH_COMMAND=npx wrangler pages deploy "$SITE_DIR" --project-name vystara
PUBLISH_COMMAND=

# Token van je Cloudflare Tunnel (alleen nodig met: docker compose --profile tunnel up -d)
TUNNEL_TOKEN=

# Optioneel: formulierinzendingen doorsturen. Een Discord-webhook-URL werkt direct
# (Kanaal → Integraties → Webhooks). Andere URL's krijgen JSON: { form, data }.
FORM_WEBHOOK_URL=

# Optioneel: naast MP4 ook een (kleinere) WebM maken van elke video. Kost meer rekentijd.
# Video's met transparantie krijgen altijd een WebM met alfakanaal.
VIDEO_WEBM=0
