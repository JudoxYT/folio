{
  "name": "folio",
  "productName": "Folio",
  "version": "0.1.2",
  "description": "Bouw en publiceer je eigen website, zonder te programmeren.",
  "author": "Folio",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "start": "npm run bundle && electron .",
    "dist": "npm run bundle && electron-builder",
    "dist:win": "npm run bundle && electron-builder --win",
    "dist:mac": "npm run bundle && electron-builder --mac",
    "dist:linux": "npm run bundle && electron-builder --linux"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "electron-updater": "^6.6.2",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "app.folio.desktop",
    "productName": "Folio",
    "copyright": "Folio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "app/**",
      "build/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/@ffprobe-installer/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "JudoxYT",
        "repo": "folio",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Folio",
      "artifactName": "Folio-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "identity": null,
      "artifactName": "Folio-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "build/icon.png"
    },
    "fileAssociations": [
      {
        "ext": "folio",
        "name": "Folio-website",
        "description": "Folio-website",
        "role": "Editor"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JudoxYT/folio.git"
  }
}
